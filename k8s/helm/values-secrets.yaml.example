# Copy to values-secrets.yaml (gitignored), fill in real values, and layer it last:
#   helm upgrade --install rag-api . -n rag --create-namespace \
#     -f values.yaml -f values-secrets.yaml
#
# Mirrors the secretGenerator .env files that used to live under each component's
# kustomize/overlays/<env>/secrets/*.env — one Secret per top-level key.

secrets:
  rag-api-credentials:
    # rag_api's own S3 client only reads S3_ACCESS_KEY/S3_SECRET_KEY (settings.py) — must
    # match minio-root-secret's rootUser/rootPassword below (that's what bootstraps MinIO).
    S3_ACCESS_KEY: ""
    S3_SECRET_KEY: ""
    REDIS_PASSWORD: ""
    POSTGRES_USER: "" # must match cnpg-cluster.secrets.cnpg-rag-api-role.username below
    POSTGRES_PASSWORD: "" # must match cnpg-cluster.secrets.cnpg-rag-api-role.password below
    OPENAI_API_KEY: ""
    RERANKER_API_KEY: ""
    OIDC_ADMIN_CLIENT_ID: ""
    OIDC_ADMIN_CLIENT_SECRET: ""
    SMTP_USERNAME: ""
    SMTP_PASSWORD: ""
    TRACING_LANGFUSE_PUBLIC_KEY: ""
    TRACING_LANGFUSE_SECRET_KEY: ""
  redis-auth:
    REDIS_PASSWORD: ""
  minio-root-secret:
    rootUser: ""
    rootPassword: ""
  mailpit-smtp-auth:
    smtp.htpasswd: "" # htpasswd-format line, e.g. `admin@example.com:$2y$05$...`
  # Required unconditionally by every dagster component (webserver/daemon/user-deployments)
  # for DAGSTER_PG_PASSWORD, regardless of generatePostgresqlPasswordSecret — must match
  # cnpg-cluster.secrets.cnpg-dagster-role.password below (same "dagster" postgres role).
  dagster-postgresql-secret:
    postgresql-password: ""

cnpg-cluster:
  secrets:
    cnpg-rag-api-role:
      username: rag-api
      password: ""
    cnpg-dagster-role:
      username: dagster
      password: ""
    cnpg-langfuse-role:
      username: langfuse
      password: ""
