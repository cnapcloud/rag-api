# DEMO ONLY — placeholder credentials, not for real deployment. Copy to values.yaml
# (gitignored), run from k8s/, layered after the chart's own helm/values.yaml:
#   helm upgrade --install rag ./helm -n rag --create-namespace \
#     -f helm/values.yaml -f values.yaml
#
# Mirrors the secretGenerator .env files that used to live under each component's
# kustomize/overlays/<env>/secrets/*.env — one Secret per top-level key.

secrets:
  rag-api-credentials:
    # rag_api's own S3 client only reads S3_ACCESS_KEY/S3_SECRET_KEY (settings.py) — must
    # match minio-root-secret's rootUser/rootPassword below (that's what bootstraps MinIO).
    S3_ACCESS_KEY: "admin"
    S3_SECRET_KEY: "password"
    REDIS_PASSWORD: "password"
    POSTGRES_USER: "rag-api" # must match cnpg-cluster.secrets.cnpg-rag-api-role.username below
    POSTGRES_PASSWORD: "password" # must match cnpg-cluster.secrets.cnpg-rag-api-role.password below
    OPENAI_API_KEY: "sk-demo-0000000000000000000000000000"
    RERANKER_API_KEY: "demo-reranker-api-key-000000"
    OIDC_ADMIN_CLIENT_ID: "demo-admin-client-id"
    OIDC_ADMIN_CLIENT_SECRET: "demo-admin-client-secret"
    SMTP_USERNAME: "admin"
    SMTP_PASSWORD: "password"
    TRACING_LANGFUSE_PUBLIC_KEY: "pk-lf-demo0000000000000000000000"
    TRACING_LANGFUSE_SECRET_KEY: "sk-lf-demo0000000000000000000000"
  redis-auth:
    REDIS_PASSWORD: "password"
  minio-root-secret:
    rootUser: "admin"
    rootPassword: "password"
  mailpit-smtp-auth: # real bcrypt hash of "password", matching SMTP_USERNAME/PASSWORD above
    smtp.htpasswd: "admin:$2y$05$ojR5pRLEZEMVk1ClDDyjBuXJmEk6fpfVQ/5h4yOHhiEM1Iiec/ikO"
  # Required unconditionally by every dagster component (webserver/daemon/user-deployments)
  # for DAGSTER_PG_PASSWORD, regardless of generatePostgresqlPasswordSecret — must match
  # cnpg-cluster.secrets.cnpg-dagster-role.password below (same "dagster" postgres role).
  dagster-postgresql-secret:
    postgresql-password: "password"

cnpg-cluster:
  secrets:
    cnpg-rag-api-role:
      username: rag-api
      password: "password"
    cnpg-dagster-role:
      username: dagster
      password: "password"
    cnpg-langfuse-role:
      username: langfuse
      password: "password"
