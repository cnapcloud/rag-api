# Credential values for docker-compose services and the Settings env var
# overrides (see rag-api's src/rag_api/config/settings.py Settings.from_yaml(),
# reused by src/rag_ent/config/settings.py). Tracked in git intentionally as a
# reference local dev config -- only local-dev-grade placeholder values here.

# MinIO. The official minio image reads MINIO_ROOT_USER/MINIO_ROOT_PASSWORD; the
# rag-api app reads S3_ACCESS_KEY/S3_SECRET_KEY. Same credential, two required
# names -- keep both pairs in sync.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password

# Redis. Both the redis-server --requirepass flag (docker-compose.yml) and the
# rag-api app read this same variable name.
REDIS_PASSWORD=redis

# Postgres app user (created by docker/init-db.sql). init-db.sql currently
# hardcodes this password as a SQL literal, so changing it here does not rotate
# the real DB password by itself -- init-db.sql must be updated and the
# postgresql volume recreated for a password change to take effect.
POSTGRES_USER=rag-api
POSTGRES_PASSWORD=password

# OpenAI embedding provider (only read when embedding.provider=openai).
OPENAI_API_KEY=

# Jina reranker API key (rerank.enabled is false, so blank is fine for now).
RERANKER_API_KEY=jina_026dc0b5a8ff4e6480914e208c1e0682eZK1BWvhq7gdXbQQxRPjP2rZXFo-

# rag-ent-api extension secrets (already had env override support before this
# session; consolidated here alongside the base ones for a single source).
OIDC_ADMIN_CLIENT_ID=
OIDC_ADMIN_CLIENT_SECRET=
SMTP_USERNAME=admin
SMTP_PASSWORD=password

# Langfuse tracing (tracing.enabled is also false in settings.yaml).
TRACING_LANGFUSE_PUBLIC_KEY=pk-lf-0142e4e5-b7e2-446f-8471-40be8d9c7009
TRACING_LANGFUSE_SECRET_KEY=sk-lf-ad5e55e4-5a84-4442-ad6f-59170dff7900
