# Credential values for docker-compose services and the rag-api app's Settings
# env var overrides (see src/rag_api/config/settings.py Settings.from_yaml()).
# Gitignored (.env*) -- do not commit real values here.

# MinIO. The official minio image reads MINIO_ROOT_USER/MINIO_ROOT_PASSWORD; the
# rag-api app reads S3_ACCESS_KEY/S3_SECRET_KEY. Same credential, two required
# names -- keep both pairs in sync.
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password

# Redis. Both the redis-server --requirepass flag (docker-compose.yml) and the
# rag-api app read this same variable name.
REDIS_PASSWORD=redis

# Postgres app user (created by docker/init-db.sql). init-db.sql currently
# hardcodes this password as a SQL literal, so changing it here does not rotate
# the real DB password by itself -- init-db.sql must be updated and the
# postgresql volume recreated for a password change to take effect.
POSTGRES_USER=rag-api
POSTGRES_PASSWORD=password

# Jina reranker API key. This is Jina's public demo key (shared, rate-limited,
# can expire/rotate without notice) -- for real usage, get your own key at
# https://jina.ai/reranker and replace this value.
RERANKER_API_KEY=jina_026dc0b5a8ff4e6480914e208c1e0682eZK1BWvhq7gdXbQQxRPjP2rZXFo-

# Langfuse tracing. Blank = disabled (tracing.enabled is also false in settings.yaml).
# Demo/test Langfuse project keys -- not a production credential, replace with
# your own project's keys at https://cloud.langfuse.com (or your self-hosted instance).
TRACING_LANGFUSE_PUBLIC_KEY=pk-lf-519beb9c-e8f0-4e2f-b090-44b556c4af6c
TRACING_LANGFUSE_SECRET_KEY=sk-lf-cdab0fc2-e06c-4480-8828-1a3410419dd6

# OpenAI embedding provider (only read when embedding.provider=openai).
OPENAI_API_KEY=

# Connector config secret encryption key (Fernet, URL-safe base64, 32 bytes).
# Without this, infra/crypto.py falls back to a well-known default key derived
# from a fixed passphrase in the source -- fine for this local docker-compose
# stack, but generate your own for any real deployment:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_SECRET_KEY=MFh70Rg_MbXgBZWlR0n2j4OqCB3ynmz38T9Cdb7E9v4=
